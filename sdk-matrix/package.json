    "nock": "^13.5.6",
    "node-mocks-http": "^1.18.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-svgo": "^3.0.0",
